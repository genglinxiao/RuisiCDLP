<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform Condition="'$(Platform)' == ''">x86</Platform>
    <TargetProfile Condition="'$(TargetProfile)' == ''">win7</TargetProfile>
    <XpEnforcement Condition="'$(XpEnforcement)' == ''">cm</XpEnforcement>
    <ProductVersion Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'setupapi'">1.1.6</ProductVersion>
    <ProductVersion Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'filter'">1.1.8</ProductVersion>
    <ProductVersion Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'cm'">1.1.5</ProductVersion>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.1.0</ProductVersion>
    <IntermediateOutputPath>obj\$(TargetProfile)\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <InstallerPlatform>$(Platform)</InstallerPlatform>
    <LegacyArch Condition="'$(Platform)' == 'x64'">x64</LegacyArch>
    <LegacyArch Condition="'$(LegacyArch)' == ''">x86</LegacyArch>
    <ProgramFilesId Condition="'$(Platform)' == 'x64'">ProgramFiles64Folder</ProgramFilesId>
    <ProgramFilesId Condition="'$(ProgramFilesId)' == ''">ProgramFilesFolder</ProgramFilesId>
    <ComponentBitness Condition="'$(Platform)' == 'x64'">always64</ComponentBitness>
    <ComponentBitness Condition="'$(ComponentBitness)' == ''">always32</ComponentBitness>
    <PayloadDir Condition="'$(TargetProfile)' == 'win7'">$(MSBuildThisFileDirectory)..\..\legacy\build-win7-$(LegacyArch)\Release</PayloadDir>
    <PayloadDir Condition="'$(TargetProfile)' == 'win10'">$(MSBuildThisFileDirectory)..\..\legacy\build-win10-$(LegacyArch)\Release</PayloadDir>
    <PayloadDir Condition="'$(TargetProfile)' == 'xp'">$(MSBuildThisFileDirectory)..\..\legacy\build-xp-x86\Release</PayloadDir>
    <PayloadDir Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'setupapi'">$(MSBuildThisFileDirectory)..\..\legacy\build-xp-setupapi\Release</PayloadDir>
    <PayloadDir Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'filter'">$(MSBuildThisFileDirectory)..\..\legacy\build-xp-filter\Release</PayloadDir>
    <OutputName Condition="'$(TargetProfile)' == 'win7'">RuisiUsbDlpLegacyAgent-1.1.0-$(LegacyArch)</OutputName>
    <OutputName Condition="'$(TargetProfile)' == 'win10'">RuisiUsbDlpWin10Agent-1.1.0-$(LegacyArch)</OutputName>
    <OutputName Condition="'$(TargetProfile)' == 'xp'">RuisiUsbDlpXpAgent-$(ProductVersion)-x86</OutputName>
    <OutputName Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'setupapi'">RuisiUsbDlpXpSetupApiAgent-$(ProductVersion)-x86</OutputName>
    <OutputName Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'filter'">RuisiUsbDlpXpFilterAgent-$(ProductVersion)-x86</OutputName>
    <ProductName Condition="'$(TargetProfile)' == 'win7'">Ruisi USB DLP Windows 7 Agent ($(LegacyArch))</ProductName>
    <ProductName Condition="'$(TargetProfile)' == 'win10'">Ruisi USB DLP Windows 10 Agent ($(LegacyArch))</ProductName>
    <ProductName Condition="'$(TargetProfile)' == 'xp'">Ruisi USB DLP Windows XP Agent (x86)</ProductName>
    <ProductName Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'setupapi'">Ruisi USB DLP Windows XP SetupAPI Agent (x86)</ProductName>
    <ProductName Condition="'$(TargetProfile)' == 'xp' and '$(XpEnforcement)' == 'filter'">Ruisi USB DLP Windows XP Filter Agent (x86)</ProductName>
    <ProductUpgradeCode Condition="'$(TargetProfile)' == 'win7' and '$(Platform)' == 'x86'">{E2B32BC7-94DC-460D-A0E6-A4B8AA967742}</ProductUpgradeCode>
    <ProductUpgradeCode Condition="'$(TargetProfile)' == 'win7' and '$(Platform)' == 'x64'">{5B1E5139-AE88-4BA9-9FDE-4DD682A9B4BC}</ProductUpgradeCode>
    <ProductUpgradeCode Condition="'$(TargetProfile)' == 'win10' and '$(Platform)' == 'x86'">{45E00DA9-C058-45F3-9F85-21ABDBD1EC0C}</ProductUpgradeCode>
    <ProductUpgradeCode Condition="'$(TargetProfile)' == 'win10' and '$(Platform)' == 'x64'">{975D4270-DBF1-4FBA-B10B-8D699C17BEF3}</ProductUpgradeCode>
    <ProductUpgradeCode Condition="'$(TargetProfile)' == 'xp'">{25B625A0-F0E2-4F74-B1C4-833ABDFB022A}</ProductUpgradeCode>
    <DefineConstants>PayloadDir=$(PayloadDir);ProgramFilesId=$(ProgramFilesId);ComponentBitness=$(ComponentBitness);LegacyArch=$(LegacyArch);TargetProfile=$(TargetProfile);ProductName=$(ProductName);ProductVersion=$(ProductVersion);ProductUpgradeCode=$(ProductUpgradeCode)</DefineConstants>
  </PropertyGroup>
  <Target Name="RejectUnsupportedXpArchitecture" BeforeTargets="Build" Condition="'$(TargetProfile)' == 'xp' and '$(Platform)' != 'x86'">
    <Error Text="The Windows XP profile supports x86 only." />
  </Target>
</Project>
