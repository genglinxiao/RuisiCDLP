@model IReadOnlyList<UsbDlp.Server.Data.PolicyRow>
@inject UsbDlp.Server.SharedResource L
<div class="table-wrap"><table><thead><tr><th>@L["Device"]</th><th>Match</th><th>@L["Scope"]</th><th>@L["Action"]</th><th>Expiry</th></tr></thead><tbody>
@if(Model.Count==0){<tr><td colspan="5" class="empty">No policy entries. Default group behavior still applies.</td></tr>}
@foreach(var item in Model){<tr><td><strong>@item.DisplayName</strong>@if(item.Mandatory){<small class="mandatory">@L["Mandatory global block"]</small>}</td><td><code>@item.MatchValue</code><small>@item.MatchType.ToString()</small></td><td><span class="badge scope">@item.ScopeType</span></td><td><span class="decision @item.Action.ToString().ToLowerInvariant()">@item.Action</span></td><td>@(item.ExpiresAtUtc?.ToLocalTime().ToString("g") ?? "Never")</td></tr>}
</tbody></table></div>
